import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# ============================================
# Step 2: Load the Data
# ============================================
# Paths to your uploaded CSVs
spatial_temporal_csv = "UrbanPulse Metrics CSV location"
temporal_pulse_csv = "Urban Cluster and Gravity CSV file location"

# Read both CSVs
spatial_df = pd.read_csv(spatial_temporal_csv)
temporal_df = pd.read_csv(temporal_pulse_csv)

# ============================================
# Step 3: Clean and Align Columns
# ============================================
# Fix column names if needed
spatial_df.rename(columns={'City': 'city', 'Day_Type': 'day_type'}, inplace=True)
temporal_df.rename(columns={'City': 'city', 'Day_Type': 'day_type'}, inplace=True)

# Clean city names
spatial_df['city'] = spatial_df['city'].str.strip()
temporal_df['city'] = temporal_df['city'].str.strip()

# Clean day_type if needed
spatial_df['day_type'] = spatial_df['day_type'].str.strip().str.lower()
temporal_df['day_type'] = temporal_df['day_type'].str.strip().str.lower()

# ============================================
# Step 4: Merge the Datasets
# ============================================
# Merge based on city and day_type
merged_df = pd.merge(spatial_df, temporal_df, on=['city', 'day_type'], how='inner')

print(f"✅ Total rows after merge: {merged_df.shape[0]} cities")
merged_df.to_csv("/content/merged_city_metrics.csv", index=False)

# ============================================
# Step 5: Convert peak_time to Numerical Minutes
# ============================================
def convert_peak_time_to_minutes(peak_time_str):
    try:
        if pd.isna(peak_time_str):
            return np.nan
        t = pd.to_datetime(peak_time_str, format="%H:%M")
        return t.hour * 60 + t.minute
    except:
        return np.nan

merged_df['peak_time_minutes'] = merged_df['peak_time'].apply(convert_peak_time_to_minutes)

# ============================================
# Step 6: Prepare Data for Correlation
# ============================================
# Select only numeric features (drop non-numeric)
feature_df = merged_df.select_dtypes(include=[np.number])

print(f"✅ Total numeric features for correlation: {feature_df.shape[1]}")

# ============================================
# Step 7: Compute Correlations
# ============================================
# Pearson (linear)
pearson_corr = feature_df.corr(method='pearson')

# Spearman (nonlinear)
spearman_corr = feature_df.corr(method='spearman')

# Save correlation matrices
pearson_corr.to_csv("/content/pearson_correlation_matrix.csv")
spearman_corr.to_csv("/content/spearman_correlation_matrix.csv")

# ============================================
# Step 8: Visualize Heatmaps
# ============================================
# Pearson Heatmap
plt.figure(figsize=(20, 16))
sns.heatmap(pearson_corr, cmap='coolwarm', center=0, annot=False)
plt.title("📈 Pearson Correlation Heatmap (Linear Relationships)", fontsize=18)
plt.tight_layout()
plt.savefig("/content/pearson_correlation_heatmap.png", dpi=300)
plt.close()

# Spearman Heatmap
plt.figure(figsize=(20, 16))
sns.heatmap(spearman_corr, cmap='coolwarm', center=0, annot=False)
plt.title("🔀 Spearman Correlation Heatmap (Monotonic Relationships)", fontsize=18)
plt.tight_layout()
plt.savefig("/content/spearman_correlation_heatmap.png", dpi=300)
plt.close()

print("\n🎯 Correlation analysis completed!")
print("- Pearson and Spearman matrices saved")
print("- Heatmaps generated")

