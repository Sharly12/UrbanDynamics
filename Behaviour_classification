# ============================================
# Step 0: Import libraries
# ============================================
import pandas as pd

# ============================================
# Step 1: Load dataset and thresholds
# ============================================
merged_df = pd.read_csv("/content/drive/MyDrive/city_correlation/merged_city_metrics.csv")
thresholds_df = pd.read_csv("/content/drive/MyDrive/city_correlation/outputs/metric_thresholds_summary.csv", index_col=0)

print(f"✅ Dataset Loaded: {merged_df.shape[0]} cities")

# ============================================
# Step 2: Define thresholds dictionary
# ============================================
thresholds = thresholds_df.to_dict(orient='index')

# Helper function to check if a metric is HIGH, MEDIUM, LOW
def check_level(value, metric):
    if metric not in thresholds:
        return None
    if value <= thresholds[metric]['25%']:
        return "low"
    elif value >= thresholds[metric]['75%']:
        return "high"
    else:
        return "moderate"

# ============================================
# Step 3: Define Typology Conditions
# ============================================
def evaluate_typologies(city_row):
    scores = {}

    # Type 1: Rhythmic Polycentric
    score = 0
    score += (check_level(city_row['total_activity_x'], 'total_activity_x') == "moderate")
    score += (check_level(city_row['num_segments'], 'num_segments') == "moderate")
    score += (check_level(city_row['num_change_points'], 'num_change_points') == "moderate")
    score += (check_level(city_row['num_peaks'], 'num_peaks') == "low")
    score += (check_level(city_row['cv'], 'cv') == "low")
    score += (check_level(city_row['num_rebounds'], 'num_rebounds') == "low")
    scores['Type 1: Rhythmic Polycentric'] = score / 6

    # Type 2: Hyperdynamic Nodes
    score = 0
    score += (check_level(city_row['num_change_points'], 'num_change_points') == "high")
    score += (check_level(city_row['num_peaks'], 'num_peaks') == "high")
    score += (check_level(city_row['num_rebounds'], 'num_rebounds') == "high")
    score += (check_level(city_row['cv'], 'cv') == "high")
    score += (check_level(city_row['total_trajectory_length_km'], 'total_trajectory_length_km') == "high")
    score += (check_level(city_row['avg_cluster_area_km2'], 'avg_cluster_area_km2') == "low")
    score += (check_level(city_row['avg_cluster_duration_hrs'], 'avg_cluster_duration_hrs') == "low")
    scores['Type 2: Hyperdynamic Nodes'] = score / 7

    # Type 3: Stable Compact Monocentric
    score = 0
    score += (check_level(city_row['activity_gini_index'], 'activity_gini_index') == "high")
    score += (check_level(city_row['num_segments'], 'num_segments') == "low")
    score += (check_level(city_row['num_change_points'], 'num_change_points') == "low")
    score += (check_level(city_row['total_trajectory_length_km'], 'total_trajectory_length_km') == "low")
    scores['Type 3: Stable Compact Monocentric'] = score / 4

    # Type 4: Dispersed Suburbanizing Fields
    score = 0
    score += (check_level(city_row['avg_cluster_area_km2'], 'avg_cluster_area_km2') == "high")
    score += (check_level(city_row['activity_gini_index'], 'activity_gini_index') == "low")
    score += (check_level(city_row['num_peaks'], 'num_peaks') == "low")
    score += (check_level(city_row['num_rebounds'], 'num_rebounds') == "low")
    score += (check_level(city_row['total_activity_x'], 'total_activity_x') == "low")
    scores['Type 4: Dispersed Suburbanizing Fields'] = score / 5

    # Type 5: Pulsing Dense Urban Cores
    score = 0
    score += (check_level(city_row['num_peaks'], 'num_peaks') == "high")
    score += (check_level(city_row['num_rebounds'], 'num_rebounds') == "high")
    score += (check_level(city_row['activity_gini_index'], 'activity_gini_index') == "high")
    score += (check_level(city_row['total_trajectory_length_km'], 'total_trajectory_length_km') in ["moderate", "high"])
    scores['Type 5: Pulsing Dense Urban Cores'] = score / 4

    return scores

# ============================================
# Step 4: Apply Typology Scoring
# ============================================
city_typologies = []

for idx, city in merged_df.iterrows():
    scores = evaluate_typologies(city)
    primary_typology = max(scores, key=scores.get)
    secondary_typology = None

    # If second best is reasonably close (> 70% of primary)
    sorted_scores = sorted(scores.items(), key=lambda x: x[1], reverse=True)
    if len(sorted_scores) > 1 and sorted_scores[1][1] >= 0.7 * sorted_scores[0][1]:
        secondary_typology = sorted_scores[1][0]

    if secondary_typology:
        final_typology = f"{primary_typology} - {secondary_typology}"
    else:
        final_typology = primary_typology

    city_typologies.append(final_typology)

merged_df['typology'] = city_typologies

# ============================================
# Step 5: Save Results
# ============================================
merged_df[['city', 'day_type', 'typology']].to_csv("/content/drive/MyDrive/city_correlation/final_city_typologies_with_minor_traits.csv", index=False)

print("\n✅ Dominant + Minor Trait Typology Assignment Completed!")
print("\n✅ Final classified cities saved at 'final_city_typologies_with_minor_traits.csv'")

# ============================================
# Step 6: Summary Report
# ============================================
summary = merged_df['typology'].value_counts()
print("\n🔎 Typology Distribution Summary:")
print(summary)

