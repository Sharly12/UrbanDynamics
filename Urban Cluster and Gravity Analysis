def process_city_analysis(base_path, output_root):
    """Process analysis for all automatically detected cities"""
    cities = detect_available_cities(base_path)
    if not cities:
        raise ValueError("No cities found. Check your folder structure!")

    print(f"Detected cities to process: {', '.join(cities)}")
    results = []
    os.makedirs(output_root, exist_ok=True)

    for city in cities:
        print(f"\n{'='*40}")
        print(f"PROCESSING CITY: {city.upper()}")
        print(f"{'='*40}")

        city_output_dir = os.path.join(output_root, city)
        os.makedirs(city_output_dir, exist_ok=True)

        weekday_path = os.path.join(base_path, "Weekday", f"{city}_zones_outputs", f"{city}_zones_space_time_cube.csv")
        weekend_path = os.path.join(base_path, "Weekend", city, f"{city}_space_time_cube.csv")

        for day_type, csv_path in [('Weekday', weekday_path), ('Weekend', weekend_path)]:
            if not os.path.exists(csv_path):
                print(f"⚠️ File not found, skipping: {csv_path}")
                continue

            print(f"\nProcessing {day_type} data for {city}")
            print(f"Input file: {csv_path}")

            try:
                day_output_dir = os.path.join(city_output_dir, day_type)
                os.makedirs(day_output_dir, exist_ok=True)

                gdf_timecube = create_space_time_geojson(csv_path, day_output_dir)
                grid_gdf, centroid_gdf, durations, clusterer, centroid_df = analyze_gravity_centers(gdf_timecube)
                spatial_fig, cluster_colors = visualize_spatial_results(grid_gdf, centroid_gdf, durations, clusterer)
                trajectory_fig = analyze_trajectory_patterns(centroid_df, cluster_colors)

                base_name = f"{city}_{day_type}_analysis"
                spatial_output = os.path.join(day_output_dir, f"{base_name}_spatial.png")
                spatial_fig.savefig(spatial_output, dpi=300, bbox_inches='tight')
                plt.close(spatial_fig)

                if trajectory_fig:
                    traj_output = os.path.join(day_output_dir, f"{base_name}_trajectory.png")
                    trajectory_fig.savefig(traj_output, dpi=300, bbox_inches='tight')
                    plt.close(trajectory_fig)

                duration_output = os.path.join(day_output_dir, f"{base_name}_durations.csv")
                durations.to_csv(duration_output, index=False)

                # Calculate and save enhanced metrics
                metrics_df = enhanced_metrics_analysis(grid_gdf, centroid_gdf, durations, centroid_df)
                metrics_output = os.path.join(day_output_dir, f"{base_name}_metrics.csv")
                metrics_df.to_csv(metrics_output, index=False)

                results.append({
                    'city': city,
                    'day_type': day_type,
                    'spatial_output': spatial_output,
                    'trajectory_output': traj_output if trajectory_fig else None,
                    'duration_output': duration_output,
                    'metrics_output': metrics_output,
                    'cluster_count': len(durations[durations['cluster'] != 0]),
                    'total_duration_hrs': durations[durations['cluster'] != 0]['duration_hrs'].sum() if len(durations[durations['cluster'] != 0]) > 0 else 0
                })

                print(f"✅ Successfully processed {day_type} data for {city}")

            except Exception as e:
                print(f"❌ Error processing {city} {day_type}: {str(e)}")
                continue

    return pd.DataFrame(results)

