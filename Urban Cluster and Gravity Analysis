def create_space_time_geojson(csv_path, output_dir):
    """Convert space-time cube CSV to GeoJSON format"""
    print(f"Loading CSV file: {csv_path}")
    df = pd.read_csv(csv_path)

    print("Transforming to space-time cube format...")
    pivot_df = df.pivot_table(
        index=['cell_id', 'x_utm', 'y_utm'],
        columns='time_range',
        values='count',
        fill_value=0
    ).reset_index()

    print("Creating grid geometries...")
    spatial_bin_size = 100  # meters
    pivot_df['geometry'] = [
        box(x, y, x + spatial_bin_size, y + spatial_bin_size)
        for x, y in zip(pivot_df['x_utm'], pivot_df['y_utm'])
    ]

    gdf_timecube = gpd.GeoDataFrame(pivot_df, geometry='geometry', crs='EPSG:32644')

    base_name = os.path.splitext(os.path.basename(csv_path))[0]
    geojson_path = os.path.join(output_dir, f"{base_name}_Space_Time_Cube.geojson")
    gdf_timecube.to_file(geojson_path, driver="GeoJSON")
    print(f"Saved Space-Time Cube GeoJSON to: {geojson_path}")

    return gdf_timecube

def analyze_gravity_centers(gdf_timecube):
    """Perform urban gravity center analysis with robust time parsing"""
    print("\nCalculating activity-weighted centroids...")
    time_columns = [col for col in gdf_timecube.columns if isinstance(col, str) and ':' in col and '-' in col]
    centroids = []

    for t in time_columns:
        weights = gdf_timecube[t].values
        xs = gdf_timecube.geometry.centroid.x.values
        ys = gdf_timecube.geometry.centroid.y.values
        mask = weights > 0
        if mask.sum() == 0:
            continue
        centroid_x = np.average(xs[mask], weights=weights[mask])
        centroid_y = np.average(ys[mask], weights=weights[mask])
        centroids.append({
            'time_range': t,
            'centroid_x': centroid_x,
            'centroid_y': centroid_y
        })

    centroid_df = pd.DataFrame(centroids)

    print("Performing clustering with HDBSCAN...")
    coords = centroid_df[['centroid_x', 'centroid_y']].values
    if len(coords) == 0:
        raise ValueError("No valid centroids found for clustering")

    coords_scaled = StandardScaler().fit_transform(coords)
    clusterer = hdbscan.HDBSCAN(min_cluster_size=4)
    clusters = clusterer.fit_predict(coords_scaled)
    centroid_df['cluster'] = clusters + 1

    centroid_df['geometry'] = centroid_df.apply(
        lambda row: Point(row['centroid_x'], row['centroid_y']), axis=1)
    centroid_gdf = gpd.GeoDataFrame(centroid_df, geometry='geometry', crs='EPSG:32644')

    print("Calculating cluster durations...")
    centroid_df['duration_min'] = centroid_df['time_range'].apply(parse_duration)

    # Calculate cluster durations
    cluster_durations = centroid_df.groupby('cluster')['duration_min'].sum().reset_index()
    cluster_durations['duration_hrs'] = cluster_durations['duration_min'] / 60
    cluster_durations['duration_label'] = cluster_durations.apply(
        lambda x: f"{int(x['duration_hrs'])}h {int(x['duration_min'] % 60)}m" if x['cluster'] != 0 else "Noise",
        axis=1
    )

    print("\nCluster Duration Summary:")
    print("-----------------------")
    if len(cluster_durations[cluster_durations['cluster'] != 0]) > 0:
        for _, row in cluster_durations.iterrows():
            if row['cluster'] != 0:
                print(f"Cluster {row['cluster']}: {row['duration_label']} ({row['duration_hrs']:.1f} hours)")
    else:
        print("No clusters with valid duration data")

        # Fallback: Calculate activity-based significance
        activity_sums = gdf_timecube[time_columns].sum(axis=0)
        top_time_periods = activity_sums.nlargest(3)
        print("\nTop 3 Active Time Periods (counts):")
        for time, count in top_time_periods.items():
            print(f"{time}: {count:.0f} activities")

    if len(cluster_durations[cluster_durations['cluster'] != 0]) > 0:
        total_duration = cluster_durations[cluster_durations['cluster'] != 0]['duration_min'].sum()
        cluster_durations['percentage'] = (cluster_durations['duration_min'] / total_duration) * 100

        print("\nCluster Time Distribution:")
        print("-------------------------")
        for _, row in cluster_durations.iterrows():
            if row['cluster'] != 0:
                print(f"Cluster {row['cluster']}: {row['percentage']:.1f}% of total time")
    else:
        cluster_durations['percentage'] = 0
        print("\nNo valid clusters for time distribution")

    grid_gdf_web = gdf_timecube.to_crs(epsg=3857)
    centroid_gdf_web = centroid_gdf.to_crs(epsg=3857)

    return grid_gdf_web, centroid_gdf_web, cluster_durations, clusterer, centroid_df

def visualize_spatial_results(grid_gdf_web, centroid_gdf_web, cluster_durations, clusterer):
    """Create visualization of the spatial analysis results"""
    print("\nGenerating spatial visualization...")
    fig, ax = plt.subplots(figsize=(30, 20))

    cluster_labels = sorted(centroid_gdf_web['cluster'].unique())
    cmap = plt.colormaps.get_cmap("tab20")
    cluster_colors = {cid: cmap(i % 20) for i, cid in enumerate(cluster_labels) if cid != 0}
    cluster_colors[0] = "gray"

    grid_gdf_web.plot(ax=ax, color='none', edgecolor='darkblue', linewidth=1.0, alpha=0.3,
                     label='Functional Boundary', hatch='////', zorder=1)

    for cluster_id in cluster_labels:
        if cluster_id == 0:
            continue

        cluster_data = centroid_gdf_web[centroid_gdf_web['cluster'] == cluster_id]

        if len(cluster_data) > 2:
            points = np.array([[geom.x, geom.y] for geom in cluster_data.geometry])
            hull = gpd.GeoSeries([Point(xy) for xy in points]).unary_union.convex_hull

            gpd.GeoSeries(hull).plot(ax=ax, color=cluster_colors[cluster_id],
                                    alpha=0.5, edgecolor='none', zorder=3)

            gpd.GeoSeries(hull).boundary.plot(ax=ax, color=cluster_colors[cluster_id],
                                             linewidth=3, linestyle='-', zorder=4)

    for cluster_id in cluster_labels:
        cluster_data = centroid_gdf_web[centroid_gdf_web['cluster'] == cluster_id]
        color = cluster_colors[cluster_id]

        cluster_data.plot(
            ax=ax,
            marker='o',
            markersize=80,
            alpha=0.9,
            edgecolor='white',
            linewidth=1.5,
            label=f"Cluster {cluster_id}",
            color=color,
            zorder=5
        )

    sorted_gdf = centroid_gdf_web.sort_values('time_range')
    ax.plot(sorted_gdf.geometry.x, sorted_gdf.geometry.y,
            color='black', linewidth=1, alpha=0.8, linestyle='-')

    for i, row in sorted_gdf.iterrows():
        ax.text(row.geometry.x, row.geometry.y, row['time_range'][:5],
               fontsize=7, ha='center', va='center', rotation=45)

    start = sorted_gdf.iloc[0]
    end = sorted_gdf.iloc[-1]
    ax.scatter(start.geometry.x, start.geometry.y, color='green', s=100, zorder=6)
    ax.text(start.geometry.x, start.geometry.y, " Start", fontsize=12,
           ha='left', va='center', color='green')
    ax.scatter(end.geometry.x, end.geometry.y, color='red', s=100, zorder=6)
    ax.text(end.geometry.x, end.geometry.y, " End", fontsize=12,
           ha='left', va='center', color='red')

    print("Adding basemap...")
    ctx.add_basemap(ax, crs=centroid_gdf_web.crs, source=ctx.providers.OpenStreetMap.Mapnik)

    def get_cluster_label(cid):
        if cid == 0:
            return "Noise"
        if (cid in cluster_durations['cluster'].values and
            cluster_durations[cluster_durations['cluster']==cid]['duration_min'].values[0] > 0):
            return f"Cluster {cid} ({cluster_durations[cluster_durations['cluster']==cid]['duration_label'].values[0]})"
        return f"Cluster {cid}"

    legend_elements = [
        Patch(facecolor='none', edgecolor='darkblue', hatch='////', label='Functional Boundary', alpha=0.4),
        Line2D([0], [0], marker='o', color='green', label='Start Point', markersize=15, linestyle='None'),
        Line2D([0], [0], marker='o', color='red', label='End Point', markersize=15, linestyle='None'),
        *[Patch(facecolor=cluster_colors[cid], alpha=0.7, label=get_cluster_label(cid))
          for cid in cluster_labels if cid != 0],
        *([] if 0 not in cluster_labels else [Patch(facecolor='gray', label='Noise')])
    ]

    ax.legend(handles=legend_elements, loc='upper right', fontsize=14, title='Legend', title_fontsize=16)
    ax.set_title("Urban Gravity Center Analysis with Cluster Duration", fontsize=18, pad=20)
    ax.set_axis_off()
    plt.tight_layout()

    return fig, cluster_colors

def analyze_trajectory_patterns(centroid_df, cluster_colors):
    """Analyze and visualize simplified trajectory patterns"""
    print("\nAnalyzing temporal trajectory patterns...")

    centroid_df['datetime'] = pd.to_datetime(
        centroid_df['time_range'].str.split('-').str[0],
        format='%H:%M:%S',
        errors='coerce'
    )

    if centroid_df['datetime'].isna().any():
        print("Alternative time parsing...")
        try:
            centroid_df['hour'] = centroid_df['time_range'].str.extract(r'(\d{1,2}):').astype(float)
        except:
            print("Warning: Could not reliably parse time information")
            return None

    if 'datetime' in centroid_df.columns and not centroid_df['datetime'].isna().all():
        centroid_df['hour'] = centroid_df['datetime'].dt.hour + centroid_df['datetime'].dt.minute/60
    elif 'hour' not in centroid_df.columns:
        print("Warning: No time information available for trajectory analysis")
        return None

    centroid_df['time_period'] = pd.cut(
        centroid_df['hour'],
        bins=[0, 6, 12, 18, 24],
        labels=['Night', 'Morning', 'Afternoon', 'Evening'],
        right=False
    )

    dominant_clusters = centroid_df.groupby('time_period')['cluster'].agg(
        lambda x: x.mode()[0] if not x.mode().empty else None
    ).reset_index()

    period_hours = {'Night': 3, 'Morning': 9, 'Afternoon': 15, 'Evening': 21}
    dominant_clusters['hour'] = dominant_clusters['time_period'].map(period_hours)

    print("\nSimplified Trajectory Summary:")
    print("---------------------------")
    for i in range(len(dominant_clusters)-1):
        current = dominant_clusters.iloc[i]
        next_ = dominant_clusters.iloc[i+1]
        current_label = "Noise" if current['cluster'] == 0 else f"Cluster {current['cluster']}"
        next_label = "Noise" if next_['cluster'] == 0 else f"Cluster {next_['cluster']}"
        print(f"During {current['time_period']} (∼{current['hour']}:00), "
              f"the center is mostly in {current_label}, "
              f"then moves to {next_label} in {next_['time_period']}.")

    trajectory = ["Noise" if x == 0 else f"Cluster {x}" for x in dominant_clusters['cluster'].tolist()]
    print("\nBasic Center Trajectory:", " → ".join(trajectory))

    print("Creating trajectory plot...")
    fig, ax = plt.subplots(figsize=(12, 6))
    unique_clusters = sorted(centroid_df['cluster'].unique())

    for cluster in unique_clusters:
        cluster_data = centroid_df[centroid_df['cluster'] == cluster]
        color = cluster_colors.get(cluster, "gray")
        label = f"Cluster {cluster}" if cluster != 0 else "Noise"
        ax.scatter(
            cluster_data['hour'],
            cluster_data['cluster'],
            color=color,
            s=50,
            alpha=0.7,
            label=label
        )

    ax.plot(
        dominant_clusters['hour'],
        dominant_clusters['cluster'],
        color='black',
        linestyle='--',
        marker='o',
        markersize=8,
        label='Dominant Trajectory'
    )

    ax.set_title('Simplified Center Trajectory Pattern', fontsize=14)
    ax.set_xlabel('Time of Day (Hour)', fontsize=12)
    ax.set_ylabel('Cluster', fontsize=12)
    ax.set_xticks([0, 6, 12, 18, 24])
    ax.set_xticklabels(['12AM', '6AM', '12PM', '6PM', '12AM'])

    y_ticks = unique_clusters
    ax.set_yticks(y_ticks)
    ax.set_yticklabels([f"Cluster {x}" if x != 0 else "Noise" for x in y_ticks])

    ax.grid(True, alpha=0.3)
    ax.legend()
    plt.tight_layout()

    return fig

