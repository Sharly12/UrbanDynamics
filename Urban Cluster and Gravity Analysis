def detect_available_cities(base_path):
    """Automatically detects available cities by scanning both Weekday and Weekend folders."""
    weekday_dir = os.path.join(base_path, "Weekday")
    weekend_dir = os.path.join(base_path, "Weekend")
    cities = set()

    if os.path.exists(weekday_dir):
        for folder in os.listdir(weekday_dir):
            if folder.endswith("_zones_outputs"):
                city_name = folder.replace("_zones_outputs", "")
                cities.add(city_name)

    if os.path.exists(weekend_dir):
        for folder in os.listdir(weekend_dir):
            if os.path.isdir(os.path.join(weekend_dir, folder)):
                expected_csv = os.path.join(weekend_dir, folder, f"{folder}_space_time_cube.csv")
                if os.path.exists(expected_csv):
                    cities.add(folder)

    return sorted(cities)

def parse_duration(time_range):
    """Robust time duration parser that handles HH:MM:SS format"""
    try:
        time_range = str(time_range).strip()
        if '-' not in time_range:
            return 0

        start_end = time_range.split('-')
        start_str, end_str = start_end[0].strip(), start_end[1].strip()

        # Handle HH:MM:SS format
        def parse_time(time_str):
            parts = time_str.split(':')
            if len(parts) == 3:  # HH:MM:SS
                return int(parts[0]) * 3600 + int(parts[1]) * 60 + int(parts[2])
            elif len(parts) == 2:  # HH:MM
                return int(parts[0]) * 3600 + int(parts[1]) * 60
            else:  # Unexpected format
                return 0

        start_sec = parse_time(start_str)
        end_sec = parse_time(end_str)

        if start_sec == 0 and end_sec == 0:
            return 0

        duration_min = (end_sec - start_sec) / 60
        return max(0, duration_min)  # Ensure non-negative

    except Exception as e:
        print(f"Warning: Could not parse time range '{time_range}': {str(e)}")
        return 0

def enhanced_metrics_analysis(grid_gdf_web, centroid_gdf_web, cluster_durations, centroid_df):
    """Calculate additional spatial, temporal and activity metrics"""
    print("\nCalculating enhanced metrics...")
    metrics = {}

    try:
        # Convert to UTM for accurate distance measurements
        grid_gdf = grid_gdf_web.to_crs(epsg=32644)
        centroid_gdf = centroid_gdf_web.to_crs(epsg=32644)

        # Cluster Statistics
        significant_clusters = cluster_durations[cluster_durations['cluster'] != 0]
        metrics['num_significant_clusters'] = len(significant_clusters)

        # Calculate activity-based significance if durations are zero
        time_columns = [col for col in grid_gdf.columns if isinstance(col, str) and ':' in col and '-' in col]
        activity_sums = grid_gdf[time_columns].sum(axis=0)

        if len(significant_clusters) == 0 or significant_clusters['duration_hrs'].sum() == 0:
            print("Using activity levels to determine significant clusters")
            top_periods = activity_sums.nlargest(3)
            metrics['top1_activity_period'] = top_periods.index[0] if len(top_periods) > 0 else None
            metrics['top1_activity_count'] = top_periods.iloc[0] if len(top_periods) > 0 else 0
            metrics['total_activity'] = activity_sums.sum()
        else:
            metrics['avg_cluster_duration_hrs'] = significant_clusters['duration_hrs'].mean()
            metrics['max_cluster_duration_hrs'] = significant_clusters['duration_hrs'].max()
            metrics['total_activity'] = activity_sums.sum()

        # Calculate cluster areas
        cluster_areas = []
        for cluster_id in centroid_gdf['cluster'].unique():
            if cluster_id == 0:
                continue
            cluster_points = centroid_gdf[centroid_gdf['cluster'] == cluster_id]
            if len(cluster_points) >= 3:
                hull = gpd.GeoSeries([p for p in cluster_points.geometry]).unary_union.convex_hull
                cluster_areas.append({'cluster': cluster_id, 'area_km2': hull.area / 1e6})

        if cluster_areas:
            cluster_areas_df = pd.DataFrame(cluster_areas)
            metrics['avg_cluster_area_km2'] = cluster_areas_df['area_km2'].mean()
            metrics['total_cluster_area_km2'] = cluster_areas_df['area_km2'].sum()
        else:
            metrics['avg_cluster_area_km2'] = 0
            metrics['total_cluster_area_km2'] = 0

        # Gravity Center Movement
        sorted_centroids = centroid_gdf.sort_values('time_range')
        points = list(sorted_centroids.geometry)

        # Calculate total trajectory length
        total_distance = sum(points[i].distance(points[i+1]) for i in range(len(points)-1)) / 1000
        metrics['total_trajectory_length_km'] = total_distance

        # Calculate maximum displacement
        if len(points) >= 2:
            metrics['max_displacement_km'] = points[0].distance(points[-1]) / 1000

        # Activity Metrics
        metrics['peak_activity_time'] = activity_sums.idxmax()
        metrics['peak_activity_intensity'] = activity_sums.max()

        # Gini coefficient
        all_activities = grid_gdf[time_columns].values.flatten()
        sorted_acts = np.sort(all_activities[all_activities > 0])
        if len(sorted_acts) > 0:
            n = len(sorted_acts)
            cum_acts = np.cumsum(sorted_acts)
            gini = (n + 1 - 2 * np.sum(cum_acts) / cum_acts[-1]) / n
            metrics['activity_gini_index'] = gini
        else:
            metrics['activity_gini_index'] = 0

        return pd.DataFrame([metrics])

    except Exception as e:
        print(f"Error calculating enhanced metrics: {str(e)}")
        return pd.DataFrame([{}])

